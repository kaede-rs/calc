10 CLS
20 INPUT "A: "; A
30 INPUT "B: "; B$
40 INPUT "C: "; C
50 IF B$ = "+" THEN ANSWER = A + C : GOTO 160
60 IF B$ = "-" THEN ANSWER = A - C : GOTO 160
70 IF B$ = "*" THEN ANSWER = A * C : GOTO 160
80 IF B$ = "/" THEN ANSWER = A / C : GOTO 160
90 IF B$ = "^" THEN ANSWER = A ^ C : GOTO 160
100 IF B$ = "%" THEN ANSWER = A MOD C : GOTO 160
110 IF B$ = "<" THEN ANSWER = A < C : GOTO 150
120 IF B$ = ">" THEN ANSWER = A > C : GOTO 150
130 IF B$ = "=" THEN ANSWER = A = C : GOTO 150
140 PRINT "Invalid Operator!" : END
150 IF ANSWER = -1 THEN PRINT "TRUE" ELSE PRINT "FALSE" : END
160 PRINT "Answer: "; ANSWER
170 END
